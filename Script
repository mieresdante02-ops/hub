local function notify(text, color)
    if not status or not status.Parent then return end
    status.Text = text
    status.TextColor3 = color or C.dim
    statusDot.BackgroundColor3 = color or C.dim
    task.delay(2.5, function()
        if status and status.Parent and status.Text == text then
            status.Text = "Listo"
            status.TextColor3 = C.dim
            statusDot.BackgroundColor3 = C.dim
        end
    end)
end

