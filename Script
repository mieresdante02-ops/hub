function stopFly()
    fly.active = false
    for _, c in ipairs(flyConns) do pcall(function() c:Disconnect() end) end
    table.clear(flyConns)
    table.clear(fly.keys)
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum.PlatformStand = false end) end
    if setFlyVisual then setFlyVisual(false, true) end
end

function startFly()
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then notify("Personaje no cargado", C.bad) return end
    if hrp.Anchored then hrp.Anchored = false end

    fly.active = true
    pcall(function() hum.PlatformStand = true end)

    bv = new("BodyVelocity", { MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.zero }, hrp)
    bg = new("BodyGyro", { MaxTorque = Vector3.new(1e5, 1e5, 1e5), P = 1e4, D = 500 }, hrp)

    local cam = workspace.CurrentCamera
    table.insert(flyConns, RunService.RenderStepped:Connect(function()
        if not fly.active or not screen.Parent then return end
        local c = LP.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h then return end
        if bv.Parent ~= h then bv.Parent = h end
        if bg.Parent ~= h then bg.Parent = h end

        local cf = cam.CFrame
        local dir = Vector3.zero
        if fly.keys.W or UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
        if fly.keys.S or UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
        if fly.keys.D or UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
        if fly.keys.A or UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
        if fly.keys.Space or UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
        if fly.keys.Ctrl or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end
        if dir.Magnitude > 0 then dir = dir.Unit end

        bv.Velocity = dir * fly.speed
        bg.CFrame = cf
    end))

    if setFlyVisual then setFlyVisual(true, true) end
    notify("Vuelo activado", C.good)
end

