local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude or Enum.RaycastFilterType.Blacklist
rayParams.IgnoreWater = true

local function isVisible(head, char)
    if not aim.walls then return true end
    local cam = workspace.CurrentCamera
    local filter = {}
    if LP.Character then table.insert(filter, LP.Character) end
    table.insert(filter, char)
    rayParams.FilterDescendantsInstances = filter
    local result = workspace:Raycast(cam.CFrame.Position, head.Position - cam.CFrame.Position, rayParams)
    if not result then return true end
    return result.Instance:IsDescendantOf(char)
end

local function validTarget(plr)
    if plr == LP then return nil end
    if aim.team and plr.Team and LP.Team and plr.Team == LP.Team then return nil end
    local char = plr.Character
    if not char then return nil end
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not head or not hum or hum.Health <= 0 then return nil end
    return head, char
end

local function getTarget(mousePos)
    local best, bestDist
    for _, plr in ipairs(Players:GetPlayers()) do
        local head, char = validTarget(plr)
        if head then
            local sp, onScreen = workspace.CurrentCamera:WorldToViewportPoint(head.Position)
            if onScreen then
                local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
                if d <= aim.fov and (not bestDist or d < bestDist) and isVisible(head, char) then
                    best = head
                    bestDist = d
                end
            end
        end
    end
    return best
end

