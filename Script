--  LIMPIEZA
--=============================================================
_G.VeniceHubCleanup = function()
    runtime.espLoop = false
    pcall(stopFly)
    pcall(setNoclip, false)
    pcall(stopClicker)
    pcall(vehStopAll)
    pcall(setESP, false)
    pcall(setAim, false)
    if clicker.conn then pcall(function() clicker.conn:Disconnect() end) end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    table.clear(conns)
    pcall(function() screen:Destroy() end)
    _G.VeniceHubCleanup = nil
end

