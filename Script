-- interruptor tipo switch
local function toggle(parent, labelText, default, onClick)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        LayoutOrder = nextOrder(),
        ZIndex = 12,
    }, parent)

    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -52, 1, 0),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = C.dim,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 12,
    }, row)

    local pill = new("Frame", {
        Size = UDim2.fromOffset(40, 20),
        Position = UDim2.new(1, -40, 0.5, -10),
        BackgroundColor3 = C.track,
        BorderSizePixel = 0,
        ZIndex = 12,
    }, row)
    corner(pill, 10)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.fromRGB(205, 205, 220),
        BorderSizePixel = 0,
        ZIndex = 13,
    }, pill)
    corner(knob, 7)

    local state = false
    local function set(v, silent)
        v = v and true or false
        state = v
        TweenService:Create(knob, TweenInfo.new(0.14), {
            Position = UDim2.fromOffset(v and 23 or 3, 3),
        }):Play()
        TweenService:Create(pill, TweenInfo.new(0.14), {
            BackgroundColor3 = v and C.accent or C.track,
        }):Play()
        lbl.TextColor3 = v and C.text or C.dim
        if not silent then onClick(v) end
    end

    local hit = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 14,
    }, row)
    hit.MouseButton1Click:Connect(function() set(not state) end)

    if default then set(true, true) end
    return set
end

-- deslizador con arrastre
local function slider(parent, labelText, min, max, default, callback)
    local wrap = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
        LayoutOrder = nextOrder(),
        ZIndex = 12,
    }, parent)

    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -68, 0, 16),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = C.dim,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 12,
    }, wrap)

    local box = new("TextBox", {
        Size = UDim2.fromOffset(62, 18),
        Position = UDim2.new(1, -62, 0, 0),
        BackgroundColor3 = C.panel,
        Text = tostring(default),
        TextColor3 = C.text,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        ZIndex = 12,
    }, wrap)
    corner(box, 6)
    new("UIStroke", { Color = C.accent, Transparency = 0.7 }, box)

    local trackBar = new("Frame", {
        Size = UDim2.new(1, 0, 0, 5),
        Position = UDim2.new(0, 0, 0, 28),
        BackgroundColor3 = C.track,
        BorderSizePixel = 0,
        ZIndex = 12,
    }, wrap)
    corner(trackBar, 3)

    local fill = new("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        ZIndex = 13,
    }, trackBar)
    corner(fill, 3)
    gradient(fill, C.accent, C.accent2, 0)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(11, 11),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = C.text,
        BorderSizePixel = 0,
        ZIndex = 14,
    }, trackBar)
    corner(knob, 6)

    local value = default
    local function apply(v)
        value = math.clamp(v, min, max)
        local alpha = (value - min) / (max - min)
        fill.Size = UDim2.fromScale(alpha, 1)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        box.Text = tostring(math.floor(value * 100 + 0.5) / 100)
        callback(value)
    end

    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 18),
        Position = UDim2.new(0, 0, 0, 22),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 15,
    }, wrap)

    local dragging = false
    local function fromX(x)
        local rel = (x - trackBar.AbsolutePosition.X) / math.max(trackBar.AbsoluteSize.X, 1)
        apply(min + rel * (max - min))
    end

    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromX(i.Position.X)
        end
    end)
    track(UIS.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then
            fromX(i.Position.X)
        end
    end))
    track(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then apply(n) else apply(value) end
    end)

    apply(default)
end

-- botón
local function button(parent, text, style, layoutOrder)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = style == "accent" and C.accent or (style == "bad" and C.bad or C.panel),
        Text = text,
        TextColor3 = style and C.text or C.dim,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        LayoutOrder = layoutOrder or nextOrder(),
        ZIndex = 12,
    }, parent)
    corner(b, 8)
    if style == "accent" then gradient(b, C.accent, C.accent2, 0) end
    b.MouseEnter:Connect(function() b.BackgroundColor3 = style == "accent" and C.accent2 or C.track end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = style == "accent" and C.accent or (style == "bad" and C.bad or C.panel)
    end)
    return b
end

