        del.MouseButton1Click:Connect(function()
            table.remove(waypoints, index)
            saveWaypoints()
            renderWaypoints()
            notify("Punto eliminado")
        end)
    end
end

--=============================================================
--  JUGADORES
--=============================================================
local function renderPlayers()
    for _, child in ipairs(playersList:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
    end
    local index = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            index = index + 1
            local b = new("TextButton", {
                Size = UDim2.new(1, -6, 0, 26),
                BackgroundColor3 = C.panel,
                Text = "  " .. plr.DisplayName .. "  @" .. plr.Name,
                TextColor3 = C.text,
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                BorderSizePixel = 0,
                AutoButtonColor = false,
                TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = index,
                ZIndex = 12,
            }, playersList)
            corner(b, 6)
            b.MouseEnter:Connect(function() b.BackgroundColor3 = C.track end)
            b.MouseLeave:Connect(function() b.BackgroundColor3 = C.panel end)
            b.MouseButton1Click:Connect(function()
                local char = plr.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then notify(plr.Name .. " no está cargado", C.bad) return end
                if tpTo(hrp.Position) then notify("Teletransportado a " .. plr.Name, C.good) end
            end)
        end
    end
    if index == 0 then
        new("TextLabel", {
            Size = UDim2.new(1, -6, 0, 24),
            BackgroundTransparency = 1,
            Text = "No hay otros jugadores",
            TextColor3 = C.dim,
            Font = Enum.Font.Gotham,
            TextSize = 11,
        }, playersList)
    end
end

