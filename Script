local BOX_PARTS = { "top", "bottom", "left", "right" }

local function removeESP(plr)
    local item = esp.items[plr]
    if not item then return end
    for _, key in ipairs(BOX_PARTS) do
        if item[key] then item[key]:Destroy() end
    end
    if item.fill then item.fill:Destroy() end
    if item.label then item.label:Destroy() end
    esp.items[plr] = nil
end

function clearESP()
    for plr in pairs(esp.items) do removeESP(plr) end
    table.clear(esp.items)
end

local function makeBox(plr)
    local item = {}
    item.fill = new("Frame", {
        BackgroundColor3 = C.accent,
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 3,
    }, espLayer)
    for _, key in ipairs(BOX_PARTS) do
        item[key] = new("Frame", {
            BackgroundColor3 = C.accent,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 4,
        }, espLayer)
    end
    item.label = new("TextLabel", {
        BackgroundTransparency = 1,
        Text = plr.Name,
        TextColor3 = C.accent,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextStrokeTransparency = 0,
        TextStrokeColor3 = Color3.new(0, 0, 0),
        Visible = false,
        ZIndex = 5,
    }, espLayer)
    esp.items[plr] = item
    return item
end

local function hideItem(item)
    item.fill.Visible = false
    for _, key in ipairs(BOX_PARTS) do item[key].Visible = false end
    item.label.Visible = false
end

local function project(char, cam)
    local ok, cf, size = pcall(char.GetBoundingBox, char)
    if not ok or not cf then return nil end

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local valid = 0

    for i = -1, 1, 2 do
        for j = -1, 1, 2 do
            for k = -1, 1, 2 do
                local world = cf * Vector3.new(i * size.X / 2, j * size.Y / 2, k * size.Z / 2)
                local sp = cam:WorldToViewportPoint(world)
                if sp.Z > 0 then
                    valid = valid + 1
                    minX = math.min(minX, sp.X)
                    minY = math.min(minY, sp.Y)
                    maxX = math.max(maxX, sp.X)
                    maxY = math.max(maxY, sp.Y)
                end
            end
        end
    end

    if valid < 4 then return nil end
    local vp = cam.ViewportSize
    minX = math.clamp(minX, -80, vp.X + 80)
    maxX = math.clamp(maxX, -80, vp.X + 80)
    minY = math.clamp(minY, -80, vp.Y + 80)
    maxY = math.clamp(maxY, -80, vp.Y + 80)
    if maxX - minX < 2 or maxY - minY < 2 then return nil end
    return minX, minY, maxX, maxY
end

local function updateItem(plr, item, cam, myPos, color)
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not hrp or hum.Health <= 0 then
        hideItem(item)
        return
    end
    if myPos and (hrp.Position - myPos).Magnitude > esp.maxDist then
        hideItem(item)
        return
    end

    local minX, minY, maxX, maxY = project(char, cam)
    if not minX then
        hideItem(item)
        return
    end

    local w, h = maxX - minX, maxY - minY
    item.fill.Position = UDim2.fromOffset(minX, minY)
    item.fill.Size = UDim2.fromOffset(w, h)
    item.fill.BackgroundColor3 = color
    item.fill.Visible = true

    item.top.Position = UDim2.fromOffset(minX, minY)
    item.top.Size = UDim2.fromOffset(w, 1.5)
    item.bottom.Position = UDim2.fromOffset(minX, maxY - 1.5)
    item.bottom.Size = UDim2.fromOffset(w, 1.5)
    item.left.Position = UDim2.fromOffset(minX, minY)
    item.left.Size = UDim2.fromOffset(1.5, h)
    item.right.Position = UDim2.fromOffset(maxX - 1.5, minY)
    item.right.Size = UDim2.fromOffset(1.5, h)

    for _, key in ipairs(BOX_PARTS) do
        item[key].BackgroundColor3 = color
        item[key].Visible = true
    end

    local dist = myPos and math.floor((hrp.Position - myPos).Magnitude) or 0
    item.label.Text = string.format("%s  ·  %dm", plr.Name, dist)
    item.label.TextColor3 = color
    item.label.Size = UDim2.fromOffset(math.max(w, 90), 14)
    item.label.Position = UDim2.fromOffset(minX + w / 2 - math.max(w, 90) / 2, minY - 16)
    item.label.Visible = true
end

function buildAllESP()
    if not esp.active then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local skip = esp.team and plr.Team and LP.Team and plr.Team == LP.Team
            if not skip then pcall(makeBox, plr) end
        end
    end
end

track(RunService.RenderStepped:Connect(function()
    if not esp.active then return end
    local cam = workspace.CurrentCamera
    if not cam then return end

    local hue = (os.clock() * 0.15) % 1
    local color = Color3.fromHSV(hue, 0.72, 1)

    local myChar = LP.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myHrp and myHrp.Position

    for plr, item in pairs(esp.items) do
        if plr.Parent then
