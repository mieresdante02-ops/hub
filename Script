pickBtn.MouseButton1Click:Connect(function()
    if clicker.conn then clicker.conn:Disconnect() clicker.conn = nil end
    notify("Toca la zona de la pantalla...")
    task.wait(0.25)
    clicker.conn = UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            local p = input.UserInputType == Enum.UserInputType.Touch and input.Position or UIS:GetMouseLocation()
            clicker.pos = Vector2.new(p.X, p.Y)
            marker.Position = UDim2.fromOffset(p.X, p.Y)
            marker.Visible = true
            lastClickPos = nil
            notify("Zona marcada en " .. math.floor(p.X) .. ", " .. math.floor(p.Y), C.good)
            if clicker.conn then
                clicker.conn:Disconnect()
                clicker.conn = nil
            end
        end
    end)
end)

saveBtn.MouseButton1Click:Connect(function()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then notify("Personaje no cargado", C.bad) return end
    local name = string.sub(nameBox.Text, 1, 24)
    if name == "" then name = "Punto " .. (#waypoints + 1) end
    local p = hrp.Position
    table.insert(waypoints, { name = name, pos = { p.X, p.Y, p.Z } })
    nameBox.Text = ""
    saveWaypoints()
    renderWaypoints()
    notify("Punto guardado: " .. name, C.good)
end)

spawnBtn.MouseButton1Click:Connect(function()
    local spawnPoint = workspace:FindFirstChildOfClass("SpawnLocation")
    if spawnPoint then
        if tpTo(spawnPoint.Position) then notify("Enviado al spawn", C.good) end
    elseif tpTo(Vector3.zero) then
        notify("Sin spawn, enviado al origen", C.good)
    end
end)

refreshBtn.MouseButton1Click:Connect(renderPlayers)

panicBtn.MouseButton1Click:Connect(function()
    pcall(stopFly)
    pcall(setNoclip, false)
    pcall(stopClicker)
    pcall(vehStopAll)
    pcall(setESP, false)
    pcall(setAim, false)
    notify("Todo apagado", C.bad)
end)

--=============================================================
--  EVENTOS
--=============================================================
track(LP.CharacterAdded:Connect(function()
    task.wait(0.8)
    if fly.active then
        stopFly()
        startFly()
    end
end))

track(Players.PlayerAdded:Connect(function() task.delay(0.5, renderPlayers) end))
track(Players.PlayerRemoving:Connect(function(plr)
    removeESP(plr)
    task.delay(0.5, renderPlayers)
end))

track(UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    local key = input.KeyCode
    if key == Enum.KeyCode.K then
        screen.Enabled = not screen.Enabled
    elseif key == Enum.KeyCode.F then
        if fly.active then stopFly() else startFly() end
    elseif key == Enum.KeyCode.N then
        setNoclip(not noclip.active)
    elseif key == Enum.KeyCode.C then
        if clicker.active then stopClicker() else startClicker() end
    elseif key == Enum.KeyCode.G then
        setAim(not aim.active)
    elseif key == Enum.KeyCode.P then
        setESP(not esp.active)
    end
end))

