local function new(class, props, parent)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end

local function track(c)
    if c then table.insert(conns, c) end
    return c
end

local function corner(o, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r) }, o)
end

local function gradient(o, a, b, rot, transp)
    local g = new("UIGradient", { Rotation = rot or 0 }, o)
    g.Color = ColorSequence.new(a, b)
    if transp then g.Transparency = transp end
    return g
end

