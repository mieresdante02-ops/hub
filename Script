local function getSeat()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local seat = hum and hum.SeatPart
    if seat and seat:IsA("VehicleSeat") then return seat end
    return nil
end

local function vehDestroyForces()
    if veh.bv then veh.bv:Destroy() veh.bv = nil end
    if veh.bg then veh.bg:Destroy() veh.bg = nil end
end

local function vehLoop()
    for _, c in ipairs(veh.conns) do pcall(function() c:Disconnect() end) end
    table.clear(veh.conns)
    table.clear(veh.anchored)

    table.insert(veh.conns, RunService.Heartbeat:Connect(function()
        if not (veh.speedOn or veh.flyOn) then return end
        local seat = getSeat()
        if not seat then return end

        local root = seat.AssemblyRootPart
        if not root then return end
        if veh.anchored[root] == nil then veh.anchored[root] = root.Anchored end
        if root.Anchored then root.Anchored = false end

        if not veh.bv or veh.bv.Parent ~= root then
            vehDestroyForces()
            veh.bv = new("BodyVelocity", { MaxForce = Vector3.new(1e6, 1e6, 1e6), Velocity = Vector3.zero }, root)
        end
        if veh.flyOn then
            if not veh.bg or veh.bg.Parent ~= root then
                if veh.bg then veh.bg:Destroy() end
                veh.bg = new("BodyGyro", { MaxTorque = Vector3.new(1e6, 1e6, 1e6), P = 1e4, D = 500 }, root)
            end
            veh.bg.CFrame = CFrame.new(root.Position) * (seat.CFrame - seat.CFrame.Position)
        end

        local throttle = seat.ThrottleFloat
        local velocity = Vector3.zero
        if veh.speedOn and math.abs(throttle) > 0.05 then
            velocity += seat.CFrame.LookVector * veh.speed * throttle
        end
        if veh.flyOn then
            if fly.keys.Space or UIS:IsKeyDown(Enum.KeyCode.Space) then
                velocity += Vector3.yAxis * veh.speed
            elseif fly.keys.Ctrl or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
                velocity -= Vector3.yAxis * veh.speed
            end
        end
        veh.bv.Velocity = velocity
    end))
end

local function vehStopAll()
    veh.speedOn = false
    veh.flyOn = false
    if setVehSpeedVisual then setVehSpeedVisual(false, true) end
    if setVehFlyVisual then setVehFlyVisual(false, true) end
    for _, c in ipairs(veh.conns) do pcall(function() c:Disconnect() end) end
    table.clear(veh.conns)
    vehDestroyForces()
    for root, state in pairs(veh.anchored) do
        if root and root.Parent then pcall(function() root.Anchored = state end) end
    end
    table.clear(veh.anchored)
end

function vehToggleSpeed(state)
    state = state and true or false
    if state == veh.speedOn then return end
    veh.speedOn = state
    if veh.speedOn or veh.flyOn then
        if #veh.conns == 0 then vehLoop() end
        notify("Aceleración de vehículo activada", C.good)
    else
        vehStopAll()
        notify("Vehículo restaurado")
    end
end

function vehToggleFly(state)
    state = state and true or false
    if state == veh.flyOn then return end
    veh.flyOn = state
    if veh.speedOn or veh.flyOn then
        if #veh.conns == 0 then vehLoop() end
        notify(veh.flyOn and "Vehículo volador activado" or "Vuelo de vehículo desactivado",
            veh.flyOn and C.good or C.dim)
    else
        vehStopAll()
    end
end

