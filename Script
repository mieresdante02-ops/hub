local function holdButton(parent, label, key, ord)
    local b = new("TextButton", {
        Size = UDim2.new(1 / 4, -5, 1, 0),
        BackgroundColor3 = C.panel,
        Text = label,
        TextColor3 = C.text,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        LayoutOrder = ord,
        ZIndex = 13,
    }, parent)
    corner(b, 7)
    local function down()
        fly.keys[key] = true
        b.BackgroundColor3 = C.accent
    end
    local function up()
        fly.keys[key] = false
        b.BackgroundColor3 = C.panel
    end
    b.MouseButton1Down:Connect(down)
    b.MouseButton1Up:Connect(up)
    b.MouseLeave:Connect(up)
    b.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then down() end
    end)
    b.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then up() end
    end)
end

